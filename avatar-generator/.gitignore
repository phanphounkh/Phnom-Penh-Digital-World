# Third-party downloads (fetched by scripts/fetch_assets.py, ~330 MB) and Blender's isolated
# user directory. Never commit them.
assets/vendor/
assets/blender-user/
# Large Blender working files; regenerate them with the scripts.
output/*.blend
output/*.blend1
previews/_tmp/
# Textures regenerated on every build (graded skins, prints, atlases).
assets/generated/
# Browser-test screenshots (regenerated by viewer/test_viewer.mjs; the contact sheets in previews/ are kept).
previews/viewer/*.png
