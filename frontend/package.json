{
  "name": "ppw-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write --plugin prettier-plugin-svelte src tests playwright.config.js",
    "test:unit": "vitest run",
    "test:legacy": "node --test tests/*.test.js",
    "assets:compress": "node ../tools/blender/compress_glb.mjs",
    "start": "node server.js"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.22.0",
    "lucide-svelte": "^0.468.0",
    "maplibre-gl": "^5.24.0",
    "proj4": "^2.22.0",
    "svelte": "^5.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.5",
    "@types/proj4": "^2.5.6",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
