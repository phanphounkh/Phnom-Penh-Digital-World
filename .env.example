# Phnom Penh Digital World — copy to .env and fill in the secrets.
APP_ENV=development

# PostgreSQL + PostGIS (docker compose service "db", published on 127.0.0.1:${POSTGRES_PORT})
POSTGRES_DB=ppw
POSTGRES_USER=ppw
POSTGRES_PASSWORD=            # generate: openssl rand -hex 24
POSTGRES_PORT=5440
DATABASE_URL=postgresql+psycopg://ppw:CHANGE_ME@localhost:5440/ppw
TEST_DATABASE_URL=postgresql+psycopg://ppw:CHANGE_ME@localhost:5440/ppw_test

# Signs session tokens and verification-code hashes. generate: openssl rand -hex 32
JWT_SECRET=
SESSION_TTL_MINUTES=10080
COOKIE_SECURE=false           # must be true behind HTTPS / in production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
TRUST_PROXY_HEADERS=true      # the SvelteKit server proxies /api and sets X-Forwarded-For

# No SMS/e-mail provider is integrated yet. In development the verification code is logged by
# the API and shown in a clearly labelled developer banner. Forced off in production.
EXPOSE_DEV_VERIFICATION_CODES=true

# World
WORLD_REGION_SLUG=daun-penh-central
OSM_DATA_DIR=tools/gis/data/osm

# Frontend (SvelteKit server)
API_INTERNAL_URL=http://127.0.0.1:8000
# Base map for the location picker (MapLibre style URL). OpenFreeMap needs no key.
PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Bootstrap administrator (created by backend/scripts/seed.py). Empty password = random, printed once.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@ppw.local
SEED_ADMIN_PASSWORD=
